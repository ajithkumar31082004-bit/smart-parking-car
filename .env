# SmartPark AI - Environment Configuration Template

# Server Port
PORT=5000
NODE_ENV=development

# JWT Authentication Secret Key — REQUIRED, must be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=b90b33ab932f6d36fda594ed2fc639b125da56aafe461303051a6ca8d5d8e210841d1ffa466d533acfa8ef0e0769c3fc27cee69c0e8bdb4e4cf5450ec22ab98d

# Database Path
DB_PATH=./database/smartpark.db

# CORS — Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=*

# AWS Cloud Settings (Optional for Production Deployments)
AWS_REGION=us-east-1
S3_BUCKET_NAME=smartpark-ai-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_NOTIFICATION_ARN=

# Payment Gateway (Razorpay / Stripe Mock)
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# Supabase / External Database Configuration
SUPABASE_URL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

