# SmartPark AI - Environment Configuration Template

# Server Port
PORT=5000
NODE_ENV=development

# JWT Authentication Secret Key — REQUIRED, must be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Database Path
DB_PATH=./database/smartpark.db

# CORS — Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=*

# AWS Cloud Settings (Optional for Production Deployments)
AWS_REGION=us-east-1
S3_BUCKET_NAME=smartpark-ai-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_NOTIFICATION_ARN=

# Payment Gateway (Razorpay / Stripe Mock)
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
